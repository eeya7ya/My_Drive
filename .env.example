# ─── Cloudflare account ────────────────────────────────────────────────────
# Dashboard → right sidebar, or `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# API token used for D1 queries.
# Create at: dash.cloudflare.com → My Profile → API Tokens → Create Token
# Permissions needed: Account → D1 → Edit
CLOUDFLARE_API_TOKEN=

# ─── D1 (metadata: folders, files, settings) ───────────────────────────────
# From `npx wrangler d1 create my-drive` or the D1 dashboard.
CLOUDFLARE_D1_DATABASE_ID=

# ─── R2 (file storage) ─────────────────────────────────────────────────────
# R2 → Manage R2 API Tokens → Create API token (Object Read & Write).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=my-drive

# ─── Which drive this is ───────────────────────────────────────────────────
# The same code serves more than one drive. Leave unset (or "yahya") for the
# Yahya Khaled Power Systems Drive. Set "espark" for the eSpark drive: folders
# are numbered 1, 1.1, 1.2, 2 in tree order, the sidebar and tab read eSpark,
# and "Powered by eSpark" sits in the bottom-right corner.
DRIVE_VARIANT=

# ─── Admin panel ───────────────────────────────────────────────────────────
# The password that unlocks folder/file management.
ADMIN_PASSWORD=

# Random string, 32+ characters, used to sign the session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
